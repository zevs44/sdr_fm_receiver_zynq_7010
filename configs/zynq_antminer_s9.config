# Конфигурация сборки: OpenWrt 25.12.x, плата Bitmain Antminer S9.
#
# Это минимальный набор — остальное досоздаёт `make defconfig`.
# Полный итоговый конфиг CI выкладывает артефактом `zynq-antminer-s9.config`.

# --- цель и устройство -------------------------------------------------
CONFIG_TARGET_zynq=y
CONFIG_TARGET_zynq_generic=y
CONFIG_TARGET_zynq_generic_DEVICE_bitmain_zynq-antminer-s9=y

# --- образ -------------------------------------------------------------
# FAT-раздел под загрузчик и битстрим; корень — squashfs + overlay
CONFIG_TARGET_KERNEL_PARTSIZE=16
CONFIG_TARGET_ROOTFS_PARTSIZE=200
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=n
CONFIG_TARGET_ROOTFS_TARGZ=n
CONFIG_TARGET_ROOTFS_UBIFS=n

# --- ускорение сборки --------------------------------------------------
CONFIG_CCACHE=y

# --- базовая система ---------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=n
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# --- наши пакеты (feed antminer) --------------------------------------
# Драйвер ядра: V4L2-тюнер поверх axi_sdr_fm (требует DTS-узел)
CONFIG_PACKAGE_kmod-zynq-fm-radio=m

# Пользовательские утилиты и демоны
CONFIG_PACKAGE_fm_radio=y
CONFIG_PACKAGE_fmtx=y
CONFIG_PACKAGE_mpx-stream=y
CONFIG_PACKAGE_audiosrc=y

# LuCI-приложения
CONFIG_PACKAGE_luci-app-fmradio=y
CONFIG_PACKAGE_luci-app-fmtx=y
CONFIG_PACKAGE_luci-app-audiosrc=y
CONFIG_PACKAGE_luci-app-mympd=y

# DSP-цепочка (тяжёлые зависимости: fftw3, liquid-dsp, csdr)
CONFIG_PACKAGE_csdr=y
CONFIG_PACKAGE_csdr2=y
CONFIG_PACKAGE_redsea=y

# --- полезное для отладки ---------------------------------------------
CONFIG_PACKAGE_alsa-utils=y
CONFIG_PACKAGE_v4l-utils-new=y
CONFIG_PACKAGE_i2c-tools=y
