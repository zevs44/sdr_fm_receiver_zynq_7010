# Конфигурация сборки: OpenWrt 25.12.x, плата Bitmain Antminer S9.
#
# Это минимальный набор — остальное досоздаёт `make defconfig`.
# Полный итоговый конфиг CI выкладывает артефактом `zynq-antminer-s9.config`.

# --- цель и устройство -------------------------------------------------
CONFIG_TARGET_zynq=y
CONFIG_TARGET_zynq_generic=y
CONFIG_TARGET_zynq_generic_DEVICE_bitmain_zynq-antminer-s9=y

# --- образ -------------------------------------------------------------
# FAT-раздел под загрузчик и битстрим; корень — squashfs + overlay
CONFIG_TARGET_KERNEL_PARTSIZE=16
CONFIG_TARGET_ROOTFS_PARTSIZE=200
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=n
CONFIG_TARGET_ROOTFS_TARGZ=n

# --- ускорение сборки --------------------------------------------------
# CCACHE объявлен как `bool "Use ccache" if DEVEL`: без DEVEL символ
# недоступен и defconfig его выбрасывает — ccache молча не работал.
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# --- базовая система ---------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=n
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# --- наши пакеты (feed antminer) --------------------------------------
# Драйвер ядра: V4L2-тюнер поверх axi_sdr_fm (требует DTS-узел).
# =y, а не =m: в OpenWrt «m» означает «собрать пакет, но не ставить в образ»,
# и модуля в системе не окажется (поймал verify_image.sh на прогоне 45354756963).
CONFIG_PACKAGE_kmod-zynq-fm-radio=y

# Пользовательские утилиты и демоны
CONFIG_PACKAGE_fm_radio=y
CONFIG_PACKAGE_fmtx=y
CONFIG_PACKAGE_mpx-stream=y
CONFIG_PACKAGE_audiosrc=y

# LuCI-приложения
CONFIG_PACKAGE_luci-app-fmradio=y
CONFIG_PACKAGE_luci-app-fmtx=y
CONFIG_PACKAGE_luci-app-audiosrc=y
CONFIG_PACKAGE_luci-app-mympd=y
# Сам демон myMPD: luci-app-mympd зависит только от mpd/mpc, но не от mympd,
# поэтому без этой строки в образе не было /usr/bin/mympd.
CONFIG_PACKAGE_mympd=y

# DSP-цепочка (тяжёлые зависимости: fftw3, liquid-dsp, csdr2).
# Только csdr2: в образе автора его одного и достаточно, а старый csdr
# ставит те же /usr/bin/csdr, nmux, fm_stereo_decode, resample_upsample_f
# и /usr/lib/libcsdr.so — apk валит package/install на «trying to overwrite».
CONFIG_PACKAGE_csdr2=y
CONFIG_PACKAGE_redsea=y

# --- индикаторы PS -----------------------------------------------------
# Узлы gpio-leds объявлены в DTS: s9:red:usr (MIO37) и s9:green:usr (MIO38)
# в бэкпорте, s9:red:inner (MIO15) — нашим патчем 0320.
# Без пакета дерево устройств объявляет индикаторы, но /sys/class/leds пуст:
# в образе до 2026-11-28 драйвера не было вовсе (проверено по .config образа).
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-ledtrig-default-on=y
CONFIG_PACKAGE_kmod-ledtrig-netdev=y

# --- кнопки, зуммер, датчик температуры --------------------------------
# Кнопки MIO47 (reset) и MIO51 (ip-get): события раздаёт gpio-button-hotplug,
# поэтому встроенный драйвер keyboard-gpio отключён патчем 0340 — иначе он
# забирает узел gpio-keys первым и hotplug событий не получает.
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
# Зуммер MIO39 объявлен как gpio-leds, XADC — узлом adc: отдельных пакетов нет,
# CONFIG_XILINX_XADC и CONFIG_LEDS_GPIO уже включены в конфиге цели zynq.

# Установка системы в NAND с SD-карты: скрипт + утилиты mtd/ubi + кнопки в LuCI
CONFIG_PACKAGE_nand-install=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_luci-app-commands=y

# Каталог /myscripts и диагностика поставляются оверлеем files/ —
# режимы 0777 задаёт scripts/apply.sh (упаковщик пакетов их нормализует).

# --- полезное для отладки ---------------------------------------------
CONFIG_PACKAGE_alsa-utils=y
CONFIG_PACKAGE_v4l-utils-new=y
CONFIG_PACKAGE_i2c-tools=y

# --- зависимости для b4 (ставится в рантайме официальным установщиком) ---
# b4 требует nftables-очередь; с официальных фидов kmod не встанут,
# поэтому модули зашиваются в образ заранее.
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nft-nat=y
# kmod-nft-compat сознательно НЕ включаем: он тянет +kmod-nf-ipt (ip_tables.ko),
# а в generic-конфиге ядра 6.12 `CONFIG_NETFILTER_XTABLES is not set`, и модуль
# не собирается — сборка падает на «module 'ip_tables.ko' is missing» (прогон 45140805950).
# nftables нативно xtables-совместимость не требует.
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_ca-bundle=y
