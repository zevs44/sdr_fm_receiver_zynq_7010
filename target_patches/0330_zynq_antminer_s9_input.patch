diff --git a/target/linux/zynq/patches/0006-dts-antminer-s9-input.patch b/target/linux/zynq/patches/0006-dts-antminer-s9-input.patch
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/target/linux/zynq/patches/0006-dts-antminer-s9-input.patch
@@ -0,0 +1,51 @@
+diff --git a/arch/arm/boot/dts/xilinx/zynq-antminer-s9.dts b/arch/arm/boot/dts/xilinx/zynq-antminer-s9.dts
+index 2b98681..4079685 100644
+--- a/arch/arm/boot/dts/xilinx/zynq-antminer-s9.dts
++++ b/arch/arm/boot/dts/xilinx/zynq-antminer-s9.dts
+@@ -239,3 +239,46 @@
+ 		};
+ 	};
+ };
++
++/*
++ * Кнопки, зуммер и внутренний АЦП. Добавлено нашим патчем.
++ * Кнопки обслуживает gpio-button-hotplug: имя события берётся из label,
++ * поэтому метки заданы как reset и ip-get — на них ссылаются rc.button.
++ */
++/ {
++	gpio-keys {
++		compatible = "gpio-keys";
++
++		reset {
++			label = "reset";
++			gpios = <&gpio0 47 0x1>;
++			linux,code = <0x198>;
++			debounce-interval = <20>;
++		};
++
++		ip-get {
++			label = "ip_get";
++			gpios = <&gpio0 51 0x1>;
++			linux,code = <0x100>;
++			debounce-interval = <20>;
++		};
++	};
++
++	/*
++	 * Зуммер висит на MIO39 через транзистор Q1. Отдельного драйвера нет:
++	 * пин объявлен как индикатор, управление — /sys/class/leds/s9:buzzer.
++	 */
++	gpio-leds-buzzer {
++		compatible = "gpio-leds";
++
++		buzzer {
++			label = "s9:buzzer";
++			gpios = <&gpio0 39 0x0>;
++			default-state = "off";
++		};
++	};
++};
++
++&adc {
++	status = "okay";
++};
