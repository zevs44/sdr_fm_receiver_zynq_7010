#!/bin/sh
#
# nand_install — записать OpenWrt с SD-карты во внутреннюю NAND платы.
#
# Запускается на работающей системе, загруженной с SD-карты. Порядок проверок
# и защит — по шаблону antminer-l3-openwrt (docs/14-NAND-Install-Pattern.md):
# проверки -> dry-run с меткой -> подтверждение -> flock -> запись -> проверка
# чтением. Корневая ФС копируется из /rom (read-only squashfs), а не из
# работающей системы: так исключаются временные файлы и сама SD-карта.
#
# Использование: nand_install [--full|--system] [--dry-run] [--yes] [--force]
#
# Сообщения консоли — на английском: журнал читают в конвейере и при разборе
# с другой машины. Комментарии остаются на языке проекта.

set -eu

# --- Параметры платы ---------------------------------------------------------
SD_DEV=/dev/mmcblk0p1
MNT=/mnt/sdcard
PARTS="boot uboot fpga uboot_env kernel rootfs"

# md5 первых байт файлов: BusyBox умеет md5sum, но не od
MD5_FSBL=cd91ce4084b5a93c1399a772c9774a99     # fe ff ff ea — начало FSBL
MD5_UIMAGE=5f17afccbf287522dacddc0d09e4e03f   # 27 05 19 56 — uImage
MD5_FIT=51ac24e042ded1e5a13eed50d144d16b      # d0 0d fe ed — FIT
MD5_GZIP=5b25786f919872ca265a821a845567c0     # 1f 8b — gzip
# -----------------------------------------------------------------------------

LOG=/tmp/nand_install.log
STAMP=/tmp/nand_install.ok
LOCK=/tmp/nand_install.lock
STAMP_TTL=600

MODE=full
DRY_RUN=0
YES=0
FORCE=0

log() { printf '%s %s\n' "$(date '+%H:%M:%S')" "$*" | tee -a "$LOG"; }
die() { printf 'ERROR: %s\n' "$*" | tee -a "$LOG" >&2; exit 1; }

usage() {
	cat <<EOF
Usage: nand_install [--full|--system] [--dry-run] [--yes] [--force]

  --full      write everything: system and bootloader (default)
  --system    write the root filesystem to UBI only, leave the bootloader
  --dry-run   run all checks and print the plan, write nothing
  --yes       do not ask for confirmation
  --force     skip the dry-run stamp check and the NAND-capability check
  -h, --help  this help
EOF
}

while [ $# -gt 0 ]; do
	case "$1" in
		--full)    MODE=full ;;
		--system)  MODE=system ;;
		--dry-run) DRY_RUN=1 ;;
		--yes)     YES=1 ;;
		--force)   FORCE=1 ;;
		-h|--help) usage; exit 0 ;;
		*) echo "Unknown argument: $1" >&2; usage; exit 2 ;;
	esac
	shift
done

[ "$(id -u)" -eq 0 ] || die "root privileges required"

# --- 1. Проверка источника загрузки ------------------------------------------
case "$(cat /proc/cmdline)" in
	*root=ubi*) die "system booted from NAND — writing would damage it; boot from the SD card" ;;
esac

# --- 2. Разделы NAND ---------------------------------------------------------
mtd_idx() {
	awk -v n="$1" '$4 == "\"" n "\"" { sub(":", "", $1); sub("mtd", "", $1); print $1 }' /proc/mtd
}
mtd_size() {
	awk -v n="$1" '$4 == "\"" n "\"" { print $2 }' /proc/mtd
}
for p in $PARTS; do
	[ -n "$(mtd_idx "$p")" ] || die "no partition $p in /proc/mtd"
done

# --- 3. SD-карта -------------------------------------------------------------
# mountpoint есть не во всех сборках BusyBox: проверяем таблицу монтирования.
is_mounted() {
	awk -v m="$1" '$2 == m { found = 1 } END { exit !found }' /proc/mounts
}
mkdir -p "$MNT"
is_mounted "$MNT" || mount -t vfat -o ro "$SD_DEV" "$MNT" || die "cannot mount $SD_DEV"

# --- 4. Файлы, сигнатуры и размеры -------------------------------------------
sig() { dd if="$MNT/$1" bs=1 count="$2" 2>/dev/null | md5sum | cut -d' ' -f1; }
check_sig() {
	[ "$(sig "$1" "$2")" = "$3" ] || die "file $1 does not look like the expected one ($4)"
}
file_size() { wc -c < "$MNT/$1"; }
part_size() { printf '%d' "$((0x$(mtd_size "$1")))"; }

for f in boot.bin uboot.bin uboot_env.bin system.bit.gz fit.itb; do
	[ -f "$MNT/$f" ] || die "missing file $f on the SD card"
done

# Загрузчик должен уметь читать NAND: SPL без NAND-драйвера в режиме NAND
# не стартует. Признак собранного драйвера — строка OnDie ECC (микросхема
# Micron 2c:da). Обход только для восстановления: --force.
spl_has_string() {
	dd if="$MNT/boot.bin" bs=65536 2>/dev/null | tr -d '\000' | grep -q "$1"
}
if [ "$MODE" = full ] && [ "$FORCE" != 1 ]; then
	spl_has_string "OnDie ECC" ||
		die "boot.bin has no NAND driver: NAND boot is impossible (use --force only for recovery)"
fi

if [ "$MODE" = full ]; then
	check_sig boot.bin 4 "$MD5_FSBL" "FSBL start"
	check_sig uboot.bin 4 "$MD5_UIMAGE" "uImage header"
	check_sig system.bit.gz 2 "$MD5_GZIP" "gzip"
	check_sig fit.itb 4 "$MD5_FIT" "FIT"
	check_size() {
		[ "$(file_size "$1")" -le "$(part_size "$2")" ] ||
			die "$1 ($(file_size "$1") B) is larger than partition $2 ($(part_size "$2") B)"
	}
	check_size boot.bin boot
	check_size uboot.bin uboot
	check_size uboot_env.bin uboot_env
	check_size system.bit.gz fpga
	check_size fit.itb kernel
fi

rom_size="$(du -sk /rom | awk '{ print $1 * 1024 }')"
rootfs_size="$(part_size rootfs)"
[ "$rom_size" -le "$rootfs_size" ] ||
	die "system ($rom_size B) does not fit into the rootfs partition ($rootfs_size B)"

log "mode=$MODE dry-run=$DRY_RUN"
log "partitions: $(for p in $PARTS; do printf '%s=mtd%s ' "$p" "$(mtd_idx "$p")"; done)"
log "rootfs: /rom $rom_size B, partition $rootfs_size B"

# --- 5. Пробный запуск -------------------------------------------------------
if [ "$DRY_RUN" = 1 ]; then
	printf '%s|%s|%s\n' "$MODE" "$(date +%s)" "$rom_size" > "$STAMP"
	log "plan verified, stamp created; nothing was written"
	umount "$MNT" 2>/dev/null || true
	exit 0
fi

# --- 6. Метка dry-run --------------------------------------------------------
if [ "$FORCE" != 1 ]; then
	[ -f "$STAMP" ] || die "run --dry-run first"
	IFS='|' read -r s_mode s_time s_rom < "$STAMP"
	[ "$s_mode" = "$MODE" ] || die "stamp belongs to another mode"
	[ "$s_rom" = "$rom_size" ] || die "stamp belongs to another /rom state"
	[ $(( $(date +%s) - s_time )) -le "$STAMP_TTL" ] ||
		die "stamp expired (${STAMP_TTL} s), repeat --dry-run"
fi

# --- 7. Подтверждение --------------------------------------------------------
if [ "$YES" != 1 ]; then
	printf 'Type INSTALL to confirm: '
	read -r ans
	[ "$ans" = "INSTALL" ] || die "cancelled"
fi

# --- 8. Блокировка -----------------------------------------------------------
exec 9>"$LOCK"
flock -n 9 || die "another nand_install is already running"

# --- 9. Запись корневой ФС (первый этап) -------------------------------------
rootfs_mtd="$(mtd_idx rootfs)"
log "writing the root filesystem to UBI (mtd$rootfs_mtd)"
ubiformat "/dev/mtd$rootfs_mtd" -y || die "ubiformat failed"
ubiattach -m "$rootfs_mtd" -d 0 || die "ubiattach failed"
ubimkvol /dev/ubi0 -N rootfs -m || die "ubimkvol failed"
mkdir -p /mnt/ubi
mount -t ubifs ubi0:rootfs /mnt/ubi || die "cannot mount the new UBI volume"
cp -a /rom/. /mnt/ubi/ || die "copying /rom failed"
sync
umount /mnt/ubi
ubidetach -m "$rootfs_mtd"
log "root filesystem written"

# --- 10. Загрузчик и ядро (второй этап) --------------------------------------
if [ "$MODE" = full ]; then
	log "writing bootloader, bitstream and kernel"
	mtd write "$MNT/boot.bin" boot || die "mtd write boot failed"
	mtd write "$MNT/uboot.bin" uboot || die "mtd write uboot failed"
	mtd write "$MNT/uboot_env.bin" uboot_env || die "mtd write uboot_env failed"
	mtd write "$MNT/system.bit.gz" fpga || die "mtd write fpga failed"
	mtd write "$MNT/fit.itb" kernel || die "mtd write kernel failed"
	sync

	log "verifying by read-back"
	mtd verify "$MNT/boot.bin" boot || die "verify boot failed"
	mtd verify "$MNT/uboot.bin" uboot || die "verify uboot failed"
	mtd verify "$MNT/uboot_env.bin" uboot_env || die "verify uboot_env failed"
	mtd verify "$MNT/system.bit.gz" fpga || die "verify fpga failed"
	mtd verify "$MNT/fit.itb" kernel || die "verify kernel failed"
	log "bootloader written and verified"
fi

umount "$MNT" 2>/dev/null || true
log "done: files are written and verified"
# Предупреждение обязательно: этот загрузчик читает окружение с FAT-раздела
# SD-карты, поэтому без карты плата не стартует. Разбор — docs/03_nand_install.md.
log "note: this bootloader reads its environment from the SD card; without the card"
log "      the board will not start — see docs/03_nand_install.md"
