#!/bin/sh /etc/rc.common
# MPD (Music Player Daemon) init script for OpenWRT
# Installs to: /etc/init.d/mpd
# Enable autostart: /etc/init.d/mpd enable && /etc/init.d/mpd start

START=90
STOP=10

USE_PROCD=1

NAME=mpd
PROG=/usr/bin/mpd
PIDFILE=/var/run/mpd/pid

AUTOPLAY_FLAG=/etc/mpd_autoplay

# All directory/config-preparation logic (setup_dirs, generate_conf,
# setup_configured_paths, mpd_setup_all, and the CONF/MPD_* variables) now
# lives in this shared library, NOT in this file -- so that postinst can
# source and call it directly, without re-invoking `/etc/init.d/mpd` as a
# fresh rc.common action dispatch. See mpd-setup.sh's own header comment
# for why that re-invocation was a real problem, not just a style choice.
#
# ${IPKG_INSTROOT} prefix (empty on a live router, the target staging dir
# during an OpenWRT image build): during image build, the build system
# sources/runs this init script directly against the build host's own
# shell -- there is no chroot into the staging tree -- so a bare
# "/usr/libexec/mpd-setup.sh" would resolve against the *build host's*
# real "/", which of course doesn't have this package's files, and fail
# with "No such file or directory" even though the file is correctly
# staged at "$IPKG_INSTROOT/usr/libexec/mpd-setup.sh". Confirmed from an
# actual failed build. postinst already guarded against needing this
# (`[ -n "$IPKG_INSTROOT" ] && exit 0` up front skips it during a build
# entirely), but this script's own top-level `.` runs unconditionally
# whenever rc.common sources it -- including for a plain `enable`, which
# is exactly what an image build does to set up the boot symlink.
. "${IPKG_INSTROOT}/usr/libexec/mpd-setup.sh"

start_service() {
	[ -x "$PROG" ] || { logger -t mpd "mpd binary not found at $PROG"; return 1; }

	mpd_setup_all

	procd_open_instance
	procd_set_param command "$PROG" --no-daemon "$CONF"
	procd_set_param pidfile "$PIDFILE"
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# NOTE: autoplay is deliberately NOT triggered from here. The watcher
	# (/etc/init.d/mpd-autoplay) is a boot-enabled service that notices MPD
	# starting/restarting by itself. Two earlier attempts to launch it from
	# this function -- first as a `&` background job, then as a nested
	# `/etc/init.d/mpd-autoplay restart` call -- were unreliable, and the
	# nested variant also made LuCI's Restart button hang forever, because
	# /lib/functions/procd.sh takes a blocking flock on fd 1000 at source
	# time and every child spawned from here inherits that fd and lock.
	# Nothing is spawned from here now, so neither problem can recur.

	logger -t mpd "Started"
}

stop_service() {
	logger -t mpd "Stopped"
}

reload_service() {
	# MPD reloads config on SIGHUP
	local pid
	pid="$(cat "$PIDFILE" 2>/dev/null)"
	[ -n "$pid" ] && kill -HUP "$pid" 2>/dev/null && logger -t mpd "Reloaded (SIGHUP)" || restart
}

service_triggers() {
	# Restart if /etc/mpd.conf changes via uci/sysupgrade
	procd_add_reload_trigger "mpd"
}

# Prepares everything MPD needs (default/completed mpd.conf, the mpd
# system user, every directory and file MPD Directories & Paths currently
# points at -- music, playlists, cache, database, state, sticker database,
# log/pid parent dirs) WITHOUT starting the daemon itself. Exists so
# `opkg install` can call this from postinst: the database (or at least
# its directory/file) and every other configured path should exist right
# after installation, not only after the router is next rebooted or MPD
# is manually (re)started.
setup() {
	mpd_setup_all
	logger -t mpd "Default configuration and directories prepared"
}

extra_command "setup" "Create default mpd.conf and all configured directories without starting MPD"
