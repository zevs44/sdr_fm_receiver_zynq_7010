--- /dev/null
+++ b/src/apps/resample_upsample_f/resample_upsample_f.c
@@ -0,0 +1,83 @@
+/*
+ * resample_upsample_f.c
+ *
+ * Minimal, linear-interpolation upsampler for real float32 streams,
+ * stdin -> stdout. Written as a workaround for a memory-safety bug
+ * found in csdr's rational_resampler_ff / suboptimal_rational_resampler_ff
+ * (reproducibly reads uninitialized memory; symptom disappears under
+ * AddressSanitizer/instrumented builds, classic sign of an
+ * uninitialized-read bug that's sensitive to heap layout - not yet
+ * root-caused with enough confidence to patch safely).
+ *
+ * Only suitable for UPSAMPLING (out_rate > in_rate) of an already
+ * band-limited signal (e.g. the output of a proper decimating
+ * lowpass stage) - no anti-imaging filter is applied, since pure
+ * linear interpolation introduces no aliasing on upsampling, and any
+ * imaging artifacts land at frequencies >= (in_rate - signal_bandwidth),
+ * inaudible/filtered out by any real DAC/reconstruction filter for a
+ * signal this oversampled relative to its own bandwidth (e.g. FM mono
+ * audio content <=15kHz through a 31250Hz source has >16kHz of clean
+ * headroom before the first image).
+ *
+ * Supports N interleaved channels (default 1 = mono, unchanged from the
+ * original invocation) - each channel is interpolated independently but
+ * all channels share the same fractional timing, exactly matching how
+ * interleaved audio frames advance together. For stereo (e.g. the output
+ * of fm_stereo_decode), pass 2.
+ *
+ * Usage: resample_upsample_f <in_rate> <out_rate> [channels]
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define MAX_CHANNELS 8
+
+int main(int argc, char *argv[])
+{
+    if (argc < 3) {
+        fprintf(stderr, "usage: %s <in_rate> <out_rate> [channels]\n", argv[0]);
+        return 1;
+    }
+    double in_rate = atof(argv[1]);
+    double out_rate = atof(argv[2]);
+    int channels = (argc >= 4) ? atoi(argv[3]) : 1;
+    if (in_rate <= 0 || out_rate <= 0) {
+        fprintf(stderr, "error: rates must be positive\n");
+        return 1;
+    }
+    if (channels < 1 || channels > MAX_CHANNELS) {
+        fprintf(stderr, "error: channels must be 1-%d\n", MAX_CHANNELS);
+        return 1;
+    }
+    double step = in_rate / out_rate; /* < 1.0 for upsampling */
+
+    float prev[MAX_CHANNELS] = {0}, cur[MAX_CHANNELS] = {0};
+    int have_prev = 0;
+    double pos = 0.0; /* fractional position within the current input frame interval [0,1) */
+
+    for (;;) {
+        while (pos >= 1.0) {
+            memcpy(prev, cur, sizeof(float) * (size_t)channels);
+            if (fread(cur, sizeof(float), (size_t)channels, stdin) != (size_t)channels) {
+                return 0; /* clean EOF (or a truncated final frame - either way, done) */
+            }
+            have_prev = 1;
+            pos -= 1.0;
+        }
+        if (!have_prev) {
+            if (fread(cur, sizeof(float), (size_t)channels, stdin) != (size_t)channels) return 0;
+            memcpy(prev, cur, sizeof(float) * (size_t)channels);
+            have_prev = 1;
+        }
+        float out[MAX_CHANNELS];
+        for (int ch = 0; ch < channels; ch++)
+            out[ch] = (float)(prev[ch] + (cur[ch] - prev[ch]) * pos);
+        if (fwrite(out, sizeof(float), (size_t)channels, stdout) != (size_t)channels) {
+            fprintf(stderr, "error: write failed\n");
+            return 1;
+        }
+        pos += step;
+    }
+    return 0;
+}
