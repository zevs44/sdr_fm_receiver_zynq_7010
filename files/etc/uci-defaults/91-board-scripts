#!/bin/sh
#
# Подготовка каталога /myscripts и кнопок диагностики в LuCI.
# Выполняется один раз при первой загрузке; повторный запуск ничего не меняет.
#
# /myscripts может существовать заранее и содержать чужие файлы: пользователь
# кладёт туда свои скрипты и автоматизацию. Поэтому установка только добавляет
# недостающее — каталог не очищается, файлы не удаляются и не перезаписываются,
# кроме одного: скрипт диагностики ставит пакет, и его обновляет пакет.

[ -d /myscripts ] || mkdir -p /myscripts
chmod 0777 /myscripts 2>/dev/null || true

[ -f /myscripts/run-diag-board.sh ] || exit 0
chmod 0777 /myscripts/run-diag-board.sh 2>/dev/null || true

if uci -q show luci 2>/dev/null | grep -qF "DIAG: проверка платы"; then
	exit 0
fi

uci -q add luci command >/dev/null 2>&1 || exit 0
uci -q set luci.@command[-1].name='DIAG: проверка платы'
uci -q set luci.@command[-1].command='/myscripts/run-diag-board.sh --log /tmp/run-diag-board.log'

uci -q add luci command >/dev/null 2>&1 || exit 0
uci -q set luci.@command[-1].name='DIAG: проверка платы со звуком'
uci -q set luci.@command[-1].command='/myscripts/run-diag-board.sh --sound --log /tmp/run-diag-board.log'

uci -q commit luci
exit 0
