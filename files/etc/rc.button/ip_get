#!/bin/sh
# Action for the IP_GET button (label "ip_get" in the device tree).
# Short press: renew the DHCP lease on lan and print the address.

case "$ACTION" in
released)
	[ "$SEEN" -lt 1 ] || exit 0
	logger -t ip-get "button released, renewing DHCP on lan"
	ifup lan 2>/dev/null
	ubus call network.interface.lan renew 2>/dev/null
	sleep 3
	ip -4 addr show eth0 2>/dev/null | grep -q 'inet ' &&
		logger -t ip-get "address: $(ip -4 -o addr show eth0 | awk '{print $4}')"
	;;
esac

exit 0
